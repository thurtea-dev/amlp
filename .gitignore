# Driver build tree (rebuild locally with cmake, never sync via git)
driver/build/
driver/build_debug/

# Lil's own real, by-design runtime scratch file (driver/lil/command/
# eval.c writes this on every "eval" command use, then relies on the
# driver recompiling it fresh each time -- see ROADMAP.md's own
# programCache_ invalidation row). Regenerated with arbitrary session
# content any time eval is exercised, never meant to be tracked.
driver/lil/tmp_eval_file.c

